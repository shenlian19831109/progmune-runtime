# ── X / Twitter API v2 (OAuth 1.0a, user context) ──
# 获取：https://developer.x.com → Create App → Keys and tokens
#   API Key ........... = Consumer Key (X_API_KEY)
#   API Secret ........ = Consumer Secret (X_API_SECRET)
#   Access Token ...... = Access Token (X_ACCESS_TOKEN)
#   Access Token Secret = Access Token Secret (X_ACCESS_SECRET)
# 注意：发推需要 app 具备 Read + Write 权限（User authentication settings
#       → App permissions: Read and Write），并为用户生成 access token。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── 微博开放平台 ──
# 获取：https://open.weibo.com → 应用 → 应用信息 / 授权
# 注意：statuses/update 目前普遍要求「企业认证 + 微博内容权限」，
#       个人/普通应用 token 大概率被拒（error 20019 等）。先用
#       auth check 验证：node -e "require('./lib/weibo').authCheck(...)"
WEIBO_ACCESS_TOKEN=
# 可选：应用 App Key（source 参数）
WEIBO_APP_KEY=

# ── Dev.to（B 级半自动：API 只能建草稿 published:false，网页人工发布）──
# 获取：https://dev.to/settings/account → API Keys（或 dev.to 后台生成）
DEV_API_KEY=
