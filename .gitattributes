# Auto-detect text files, normalize line endings to LF on commit
*       text=auto

# Source code
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Binary / generated files
*.pdf   binary
*.png   binary
*.jpg   binary
*.svg   text eol=lf
*.docx  binary
dist/   -text
