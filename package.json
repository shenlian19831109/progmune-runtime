{
  "name": "progmune-runtime",
  "version": "3.2.0",
  "description": "Progmune Runtime — Program Immunology: Constraint-Guided Program Synthesis Runtime",
  "main": "dist/mcp-server.mjs",
  "bin": {
    "progmune-runtime": "dist/mcp-server.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.mcp.json && mv dist-mcp/mcp-server.js dist/mcp-server.mjs && rm -rf dist-mcp",
    "start": "node dist/mcp-server.mjs",
    "test": "node dist/mcp-server.mjs test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ir": "npx ts-node src/extract-ir.ts .",
    "guard": "node -e \"require('./dist/validator.js'); console.log('✅ 校验器已加载')\"",
    "obs": "npx ts-node src/semantic-trace.ts",
    "obs-web": "npx ts-node src/obs-web.ts",
    "check": "npx ts-node src/check.ts",
    "audit": "npx ts-node src/audit.ts",
    "governance": "npx ts-node src/audit/cli.ts --all",
    "governance:json": "npx ts-node src/audit/cli.ts --all --json",
    "governance:md": "npx ts-node src/audit/cli.ts --all --markdown",
    "certify": "npx ts-node src/certify.ts",
    "policy": "npx ts-node src/policy/cli.ts check",
    "precision": "npx ts-node src/multi-repo-precision.ts",
    "precision:json": "npx ts-node src/multi-repo-precision.ts --json",
    "ci": "npx ts-node bin/progmune-ci.ts --project .",
    "provenance": "npx ts-node src/ledger/cli.ts",
    "plsb": "npx ts-node src/plsb/cli.ts --summary",
    "plsb:export": "npx ts-node src/plsb/cli.ts --all",
    "replay-golden": "npx ts-node --transpile-only test/replay-golden.ts",
    "corpus:stats": "npx ts-node src/corpus-stats.ts",
    "corpus:mine": "npx ts-node src/rule-miner.ts",
    "test:integration": "vitest run tests/integration/",
    "test:perf": "vitest run tests/performance/",
    "test:e2e": "vitest run tests/e2e/",
    "test:chaos": "vitest run tests/chaos/",
    "test:all": "vitest run src/ tests/",
    "test:stress": "vitest run tests/stress/",
    "test:soak": "vitest run tests/soak/",
    "test:p7": "vitest run tests/p7-*/",
    "fetch:cves": "tsx scripts/fetch-cves.ts",
    "test:cve": "vitest run src/cve-benchmark.test.ts"
  },
  "keywords": [
    "program-synthesis",
    "verification",
    "mcp",
    "compiler",
    "runtime",
    "immunology"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openai": "^6.36.0",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.6",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "vitest": "^3.2.6"
  }
}