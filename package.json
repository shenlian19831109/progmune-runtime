{
  "name": "progmune-runtime",
  "version": "3.2.0",
  "description": "Progmune Runtime — Program Immunology: Constraint-Guided Program Synthesis Runtime",
  "main": "dist/mcp-server.mjs",
  "bin": {
    "progmune-runtime": "dist/mcp-server.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.mcp.json && mv dist/mcp-server.js dist/mcp-server.mjs",
    "start": "node dist/mcp-server.mjs",
    "test": "node dist/mcp-server.mjs test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ir": "npx ts-node src/extract-ir.ts .",
    "guard": "node -e \"require('./dist/validator.js'); console.log('✅ 校验器已加载')\"",
    "obs": "npx ts-node src/semantic-trace.ts",
    "obs-web": "npx ts-node src/obs-web.ts",
    "check": "npx ts-node src/check.ts",
    "audit": "npx ts-node src/audit.ts",
    "replay-golden": "npx ts-node --transpile-only test/replay-golden.ts",
    "corpus:stats": "npx ts-node src/corpus-stats.ts",
    "corpus:mine": "npx ts-node src/rule-miner.ts"
  },
  "keywords": [
    "program-synthesis",
    "verification",
    "mcp",
    "compiler",
    "runtime",
    "immunology"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openai": "^6.36.0",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.6",
    "dotenv": "^17.4.2",
    "vitest": "^3.2.6"
  }
}
