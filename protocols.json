{
  "$schema": "https://progmune.dev/schemas/protocols.json",
  "$description": "Progmune 协议定义 —— 函数调用的合法状态转换规则。支持命名空间（namespace）隔离不同资源的状态机。",
  "initialState": "UNAUTHENTICATED",
  "namespaceInitialStates": {
    "_global": "UNAUTHENTICATED",
    "auth": "UNAUTHENTICATED",
    "dev_pipeline": "IR_STALE"
  },
  "states": {
    "UNAUTHENTICATED": "初始状态：用户未认证",
    "PASSWORD_VERIFIED": "密码已通过验证",
    "TOKEN_ISSUED": "JWT 令牌已签发",
    "SESSION_ACTIVE": "会话已激活",
    "IR_STALE": "IR 已过期或未生成",
    "IR_EXTRACTED": "IR 已从源码提取",
    "ACTION_VALIDATED": "动作已通过 SVL 校验",
    "SEQUENCE_VALIDATED": "动作序列 + 变量流向已通过校验",
    "CODE_EMITTED": "目标代码已生成",
    "SESSION_RECORDED": "执行会话已保存"
  },
  "rules": {
    "verify_password": {
      "namespace": "auth",
      "pre_states": ["UNAUTHENTICATED"],
      "post_states": ["PASSWORD_VERIFIED"],
      "description": "验证用户密码 → 进入已认证状态"
    },
    "generate_jwt": {
      "namespace": "auth",
      "pre_states": ["PASSWORD_VERIFIED"],
      "post_states": ["TOKEN_ISSUED"],
      "invalidate": ["PASSWORD_VERIFIED"],
      "description": "签发 JWT 令牌 → 必须在密码验证之后，签发后密码验证状态失效"
    },
    "create_session": {
      "namespace": "auth",
      "pre_states": ["TOKEN_ISSUED"],
      "post_states": ["SESSION_ACTIVE"],
      "invalidate": ["TOKEN_ISSUED"],
      "description": "创建会话 → 必须在令牌签发之后，创建后令牌状态失效"
    },
    "revoke_token": {
      "namespace": "auth",
      "pre_states": ["TOKEN_ISSUED"],
      "post_states": ["UNAUTHENTICATED"],
      "invalidate": ["TOKEN_ISSUED"],
      "description": "撤销令牌 → 回到未认证状态"
    },
    "logout": {
      "namespace": "auth",
      "pre_states": ["SESSION_ACTIVE"],
      "post_states": ["UNAUTHENTICATED"],
      "invalidate": ["SESSION_ACTIVE"],
      "description": "登出 → 清除会话，回到未认证状态"
    },
    "open_file": {
      "namespace": "file",
      "pre_states": [],
      "post_states": ["FILE_OPEN"],
      "description": "打开文件 → 获得文件句柄"
    },
    "read_file": {
      "namespace": "file",
      "pre_states": ["FILE_OPEN"],
      "post_states": [],
      "description": "读取文件内容 → 需要文件已打开"
    },
    "write_file": {
      "namespace": "file",
      "pre_states": ["FILE_OPEN"],
      "post_states": [],
      "description": "写入文件内容 → 需要文件已打开"
    },
    "close_file": {
      "namespace": "file",
      "pre_states": ["FILE_OPEN"],
      "post_states": [],
      "invalidate": ["FILE_OPEN"],
      "description": "关闭文件句柄 → 释放文件资源"
    },
    "connect_db": {
      "namespace": "db",
      "pre_states": [],
      "post_states": ["DB_CONNECTED"],
      "description": "建立数据库连接"
    },
    "query_db": {
      "namespace": "db",
      "pre_states": ["DB_CONNECTED"],
      "post_states": [],
      "description": "执行数据库查询 → 需要已连接"
    },
    "disconnect_db": {
      "namespace": "db",
      "pre_states": ["DB_CONNECTED"],
      "post_states": [],
      "invalidate": ["DB_CONNECTED"],
      "description": "断开数据库连接"
    },
    "extractIR": {
      "namespace": "dev_pipeline",
      "pre_states": [],
      "post_states": ["IR_EXTRACTED"],
      "invalidate": ["IR_STALE"],
      "description": "从源码提取 IR → 产出 IR_EXTRACTED 状态"
    },
    "validateAction": {
      "namespace": "dev_pipeline",
      "pre_states": ["IR_EXTRACTED"],
      "post_states": ["ACTION_VALIDATED"],
      "description": "校验单个动作合法性 → 需要 IR 已提取"
    },
    "validateActionSequence": {
      "namespace": "dev_pipeline",
      "pre_states": ["ACTION_VALIDATED"],
      "post_states": ["SEQUENCE_VALIDATED"],
      "invalidate": ["ACTION_VALIDATED"],
      "description": "批量校验动作序列 → 需要动作已验证，校验后消耗"
    },
    "emitCode": {
      "namespace": "dev_pipeline",
      "pre_states": ["SEQUENCE_VALIDATED"],
      "post_states": ["CODE_EMITTED"],
      "invalidate": ["SEQUENCE_VALIDATED"],
      "description": "编译动作序列为目标代码 → 需要序列已验证"
    },
    "recordSession": {
      "namespace": "dev_pipeline",
      "pre_states": ["CODE_EMITTED"],
      "post_states": ["SESSION_RECORDED"],
      "invalidate": ["CODE_EMITTED"],
      "description": "保存执行会话到语料库 → 需要代码已生成"
    }
  }
}
