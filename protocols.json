      ],
      "invalidate": [
        "SUPPLIER_ENABLED"
      ],
      "description": "停用供应商 → 暂停接单但不取消资质"
    },
    "deregister_supplier": {
      "namespace": "supplier",
      "pre_states": [
        "SUPPLIER_REGISTERED",
        "SUPPLIER_VERIFIED"
      ],
      "post_states": [],
      "invalidate": [
        "SUPPLIER_REGISTERED",
        "SUPPLIER_VERIFIED"
      ],
      "description": "注销供应商 → 完全移除供应商资格"
    },
    "validate_order_integrity": {
      "namespace": "data_integrity",
      "pre_states": [
        "REFERENCE_CREATED"
      ],
      "post_states": [
        "REFERENCE_CREATED"
      ],
      "description": "校验订单完整性 → 验证关联数据未被篡改（自保持）"
    },
    "renew_tls_certificate": {
      "namespace": "tls",
      "pre_states": [
        "TLS_CONFIGURED"
      ],
      "post_states": [
        "TLS_CONFIGURED"
      ],
      "description": "更新 TLS 证书 → 到期前轮换证书（自保持）"
    },
    "rollback_ir": {
      "namespace": "dev_pipeline",
      "pre_states": [
        "IR_EXTRACTED",
        "ACTION_VALIDATED"
      ],
      "post_states": [
        "IR_STALE"
      ],
      "invalidate": [
        "IR_EXTRACTED",
        "ACTION_VALIDATED"
      ],
      "description": "回滚 IR → 校验失败时重置到 STALE 状态"
    },
    "cancel_order": {
      "namespace": "printlab_order",
      "pre_states": [
        "ORDER_CREATED",
        "ORDER_QUEUED"
      ],
      "post_states": [],
      "invalidate": [
        "ORDER_CREATED",
        "ORDER_QUEUED"
      ],
      "description": "取消订单 → 打印前取消，释放队列资源"
    },
    "fail_print": {
      "namespace": "printlab_print",
      "pre_states": [
        "PRINT_STARTED"
      ],
      "post_states": [],
      "invalidate": [
        "PRINT_STARTED"
      ],
      "description": "打印失败 → 材料耗尽/机器故障/翘边等"
    }
  }
}