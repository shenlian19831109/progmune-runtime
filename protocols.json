{
  "$schema": "https://progmune.dev/schemas/protocols.json",
  "$description": "Progmune 协议定义 —— 函数调用的合法状态转换规则。支持命名空间（namespace）隔离不同资源的状态机。",
  "initialState": "UNAUTHENTICATED",
  "namespaceInitialStates": {
    "_global": "UNAUTHENTICATED",
    "auth": "UNAUTHENTICATED",
    "dev_pipeline": "IR_STALE",
    "stateless": "IDLE",
    "transaction": "TX_IDLE",
    "conditional": "COND_IDLE",
    "loop": "LOOP_IDLE",
    "cross": "UNAUTHENTICATED",
    "payment": "ORDER_CREATED",
    "file_upload": "UNAUTHENTICATED",
    "api_gateway": "IDLE",
    "notification": "IDLE",
    "registration": "UNAUTHENTICATED",
    "session_mgmt": "UNAUTHENTICATED",
    "supplier": "IDLE",
    "printlab_order": "ORDER_CREATED",
    "printlab_print": "STL_UPLOADED",
    "file": "IDLE",
    "db": "IDLE",
    "resource": "IDLE",
    "data_integrity": "IDLE"
  },
  "states": {
    "UNAUTHENTICATED": "初始状态：用户未认证",
    "PASSWORD_VERIFIED": "密码已通过验证",
    "TOKEN_ISSUED": "JWT 令牌已签发",
    "SESSION_ACTIVE": "会话已激活",
    "IR_STALE": "IR 已过期或未生成",
    "IR_EXTRACTED": "IR 已从源码提取",
    "ACTION_VALIDATED": "动作已通过 SVL 校验",
    "SEQUENCE_VALIDATED": "动作序列 + 变量流向已通过校验",
    "CODE_EMITTED": "目标代码已生成",
    "SESSION_RECORDED": "执行会话已保存",
    "IDLE": "空闲状态：无状态函数可随时调用",
    "TX_IDLE": "事务空闲：无活动事务",
    "TX_ACTIVE": "事务进行中：可执行事务内操作",
    "SAVEPOINT_HELD": "保存点已创建：可回滚或释放",
    "COND_IDLE": "条件判断空闲：等待评估",
    "COND_EVALUATED": "条件已评估：等待分支选择",
    "COND_ACCEPTED": "条件通过（TRUE 分支）",
    "COND_REJECTED": "条件拒绝（FALSE 分支）",
    "COND_RESOLVED": "条件已解决：分支执行完毕",
    "LOOP_IDLE": "循环空闲：等待开始迭代",
    "FETCHING": "正在获取下一批数据",
    "BATCH_READY": "批次数据就绪",
    "ITERATING": "正在迭代处理数据项",
    "LOOP_DONE": "循环已退出",
    "AUTH_FILE_GATE": "跨协议桥：认证通过，文件操作就绪",
    "AUTH_DB_GATE": "跨协议桥：认证通过，数据库操作就绪",
    "TLS_CONFIGURED": "Auto-generated state for Investment Roadmap",
    "SERVER_STARTED": "Auto-generated state for Investment Roadmap",
    "PASSWORD_RECEIVED": "已接收用户明文密码",
    "PASSWORD_HASHED": "密码已哈希存储",
    "AUTHENTICATED": "用户已通过认证",
    "AUTHORIZED": "用户已通过授权——可以操作资源",
    "REFERENCE_VALID": "Auto-generated state for Investment Roadmap",
    "REFERENCE_CREATED": "Auto-generated state for Investment Roadmap",
    "CONTENT_SANITIZED": "Auto-generated state for Investment Roadmap",
    "TYPE_VALIDATED": "Auto-generated state for Investment Roadmap",
    "ORDER_CREATED": "订单已创建",
    "PAYMENT_INITIATED": "支付已发起",
    "PAYMENT_CALLBACK_RECEIVED": "支付回调已接收",
    "PAYMENT_CONFIRMED": "支付已确认",
    "PAYMENT_FAILED": "支付失败",
    "FILE_RECEIVED": "文件已接收",
    "FILE_VALIDATED": "文件已验证",
    "FILE_STORED": "文件已存储",
    "FILE_REFERENCED": "文件已关联",
    "RATE_CHECKED": "频率已检查",
    "THROTTLED": "已被限流",
    "NOTIFICATION_COMPOSED": "通知已生成",
    "NOTIFICATION_SENT": "通知已发送",
    "NOTIFICATION_CONFIRMED": "通知已确认",
    "USER_REGISTERED": "用户已注册",
    "VERIFICATION_CODE_SENT": "验证码已发送",
    "VERIFICATION_CONFIRMED": "验证已确认",
    "ACCOUNT_ACTIVATED": "账号已激活",
    "SESSION_CREATED": "会话已创建",
    "SESSION_REFRESHED": "会话已刷新",
    "SESSION_EXPIRED": "会话已过期",
    "SESSION_REVOKED": "会话已撤销",
    "SUPPLIER_REGISTERED": "供应商已注册",
    "SUPPLIER_VERIFIED": "供应商已验证",
    "SUPPLIER_ENABLED": "供应商已启用",
    "PRODUCT_ASSIGNED": "产品已分配",
    "STL_UPLOADED": "STL 文件已上传",
    "STL_SLICED": "STL 已切片",
    "GCODE_GENERATED": "GCode 已生成",
    "COST_ESTIMATED": "成本已估算",
    "ORDER_QUEUED": "订单已排队",
    "PRINT_STARTED": "打印已开始",
    "PRINT_COMPLETED": "打印已完成",
    "ORDER_SHIPPED": "订单已发货",
    "ORDER_DELIVERED": "订单已交付",
    "FILE_OPEN": "文件已打开——获得文件句柄",
    "DB_CONNECTED": "数据库已连接——获得连接句柄",
    "CONTENT_VALID": "内容已通过全部验证"
  },
  "rules": {
    "verify_password": {
      "namespace": "auth",
      "pre_states": [
        "UNAUTHENTICATED"
      ],
      "post_states": [
        "PASSWORD_VERIFIED"
      ],
      "description": "验证用户密码 → 进入已认证状态"
    },
    "generate_jwt": {
      "namespace": "auth",
      "pre_states": [
        "PASSWORD_VERIFIED"
      ],
      "post_states": [
        "TOKEN_ISSUED"
      ],
      "invalidate": [
        "PASSWORD_VERIFIED"
      ],
      "description": "签发 JWT 令牌 → 必须在密码验证之后，签发后密码验证状态失效"
    },
    "create_session": {
      "namespace": "auth",
      "pre_states": [
        "TOKEN_ISSUED"
      ],
      "post_states": [
        "SESSION_ACTIVE"
      ],
      "invalidate": [
        "TOKEN_ISSUED"
      ],
      "description": "创建会话 → 必须在令牌签发之后，创建后令牌状态失效"
    },
    "revoke_token": {
      "namespace": "auth",
      "pre_states": [
        "TOKEN_ISSUED"
      ],
      "post_states": [
        "UNAUTHENTICATED"
      ],
      "invalidate": [
        "TOKEN_ISSUED"
      ],
      "description": "撤销令牌 → 回到未认证状态"
    },
    "logout": {
      "namespace": "auth",
      "pre_states": [
        "SESSION_ACTIVE"
      ],
      "post_states": [
        "UNAUTHENTICATED"
      ],
      "invalidate": [
        "SESSION_ACTIVE"
      ],
      "description": "登出 → 清除会话，回到未认证状态"
    },
    "open_file": {
      "namespace": "file",
      "pre_states": [],
      "post_states": [
        "FILE_OPEN"
      ],
      "description": "打开文件 → 获得文件句柄"
    },
    "read_file": {
      "namespace": "file",
      "pre_states": [
        "FILE_OPEN"
      ],
      "post_states": [],
      "description": "读取文件内容 → 需要文件已打开"
    },
    "write_file": {
      "namespace": "file",
      "pre_states": [
        "FILE_OPEN"
      ],
      "post_states": [],
      "description": "写入文件内容 → 需要文件已打开"
    },
    "close_file": {
      "namespace": "file",
      "pre_states": [
        "FILE_OPEN"
      ],
      "post_states": [],
      "invalidate": [
        "FILE_OPEN"
      ],
      "description": "关闭文件句柄 → 释放文件资源"
    },
    "connect_db": {
      "namespace": "db",
      "pre_states": [],
      "post_states": [
        "DB_CONNECTED"
      ],
      "description": "建立数据库连接"
    },
    "query_db": {
      "namespace": "db",
      "pre_states": [
        "DB_CONNECTED"
      ],
      "post_states": [],
      "description": "执行数据库查询 → 需要已连接"
    },
    "disconnect_db": {
      "namespace": "db",
      "pre_states": [
        "DB_CONNECTED"
      ],
      "post_states": [],
      "invalidate": [
        "DB_CONNECTED"
      ],
      "description": "断开数据库连接"
    },
    "extractIR": {
      "namespace": "dev_pipeline",
      "pre_states": [],
      "post_states": [
        "IR_EXTRACTED"
      ],
      "invalidate": [
        "IR_STALE"
      ],
      "description": "从源码提取 IR → 产出 IR_EXTRACTED 状态"
    },
    "validateAction": {
      "namespace": "dev_pipeline",
      "pre_states": [
        "IR_EXTRACTED"
      ],
      "post_states": [
        "ACTION_VALIDATED"
      ],
      "description": "校验单个动作合法性 → 需要 IR 已提取"
    },
    "validateActionSequence": {
      "namespace": "dev_pipeline",
      "pre_states": [
        "ACTION_VALIDATED"
      ],
      "post_states": [
        "SEQUENCE_VALIDATED"
      ],
      "invalidate": [
        "ACTION_VALIDATED"
      ],
      "description": "批量校验动作序列 → 需要动作已验证，校验后消耗"
    },
    "emitCode": {
      "namespace": "dev_pipeline",
      "pre_states": [
        "SEQUENCE_VALIDATED"
      ],
      "post_states": [
        "CODE_EMITTED"
      ],
      "invalidate": [
        "SEQUENCE_VALIDATED"
      ],
      "description": "编译动作序列为目标代码 → 需要序列已验证"
    },
    "recordSession": {
      "namespace": "dev_pipeline",
      "pre_states": [
        "CODE_EMITTED"
      ],
      "post_states": [
        "SESSION_RECORDED"
      ],
      "invalidate": [
        "CODE_EMITTED"
      ],
      "description": "保存执行会话到语料库 → 需要代码已生成"
    },
    "compute_hash": {
      "namespace": "stateless",
      "pre_states": [],
      "post_states": [],
      "description": "计算输入数据的哈希摘要 —— 纯函数/幂等"
    },
    "validate_schema": {
      "namespace": "stateless",
      "pre_states": [],
      "post_states": [],
      "description": "对数据做 Schema 校验 —— 无副作用"
    },
    "sanitize_input": {
      "namespace": "stateless",
      "pre_states": [],
      "post_states": [],
      "description": "清理用户输入，去除危险字符"
    },
    "verify_checksum": {
      "namespace": "stateless",
      "pre_states": [],
      "post_states": [],
      "description": "通过校验和验证数据完整性"
    },
    "encode_payload": {
      "namespace": "stateless",
      "pre_states": [],
      "post_states": [],
      "description": "将数据编码为 base64 / wire format"
    },
    "decode_payload": {
      "namespace": "stateless",
      "pre_states": [],
      "post_states": [],
      "description": "从 wire format 解码回原始数据"
    },
    "compress_buffer": {
      "namespace": "stateless",
      "pre_states": [],
      "post_states": [],
      "description": "压缩数据缓冲区"
    },
    "decompress_buffer": {
      "namespace": "stateless",
      "pre_states": [],
      "post_states": [],
      "description": "解压数据缓冲区"
    },
    "begin_tx": {
      "namespace": "transaction",
      "pre_states": [
        "TX_IDLE"
      ],
      "post_states": [
        "TX_ACTIVE"
      ],
      "description": "开启新事务 → 必须在空闲状态下"
    },
    "commit_tx": {
      "namespace": "transaction",
      "pre_states": [
        "TX_ACTIVE"
      ],
      "post_states": [
        "TX_IDLE"
      ],
      "invalidate": [
        "TX_ACTIVE"
      ],
      "description": "提交活跃事务中的所有变更"
    },
    "rollback_tx": {
      "namespace": "transaction",
      "pre_states": [
        "TX_ACTIVE"
      ],
      "post_states": [
        "TX_IDLE"
      ],
      "invalidate": [
        "TX_ACTIVE"
      ],
      "description": "回滚活跃事务中的所有变更"
    },
    "insert_record": {
      "namespace": "transaction",
      "pre_states": [
        "TX_ACTIVE"
      ],
      "post_states": [
        "TX_ACTIVE"
      ],
      "description": "在活跃事务中插入记录（自保持）"
    },
    "update_record": {
      "namespace": "transaction",
      "pre_states": [
        "TX_ACTIVE"
      ],
      "post_states": [
        "TX_ACTIVE"
      ],
      "description": "在活跃事务中更新记录（自保持）"
    },
    "delete_record": {
      "namespace": "transaction",
      "pre_states": [
        "TX_ACTIVE"
      ],
      "post_states": [
        "TX_ACTIVE"
      ],
      "description": "在活跃事务中删除记录（自保持）"
    },
    "savepoint_create": {
      "namespace": "transaction",
      "pre_states": [
        "TX_ACTIVE"
      ],
      "post_states": [
        "SAVEPOINT_HELD"
      ],
      "description": "在活跃事务中创建具名保存点"
    },
    "savepoint_release": {
      "namespace": "transaction",
      "pre_states": [
        "SAVEPOINT_HELD"
      ],
      "post_states": [
        "TX_ACTIVE"
      ],
      "invalidate": [
        "SAVEPOINT_HELD"
      ],
      "description": "释放保存点，保留后续变更"
    },
    "rollback_to_savepoint": {
      "namespace": "transaction",
      "pre_states": [
        "SAVEPOINT_HELD"
      ],
      "post_states": [
        "TX_ACTIVE"
      ],
      "invalidate": [
        "SAVEPOINT_HELD"
      ],
      "description": "回滚到保存点，撤销保存点之后的变更"
    },
    "prep_two_phase": {
      "namespace": "transaction",
      "pre_states": [
        "TX_ACTIVE"
      ],
      "post_states": [
        "TX_IDLE"
      ],
      "invalidate": [
        "TX_ACTIVE"
      ],
      "description": "准备两阶段提交（表决阶段）"
    },
    "evaluate_access": {
      "namespace": "conditional",
      "pre_states": [
        "COND_IDLE"
      ],
      "post_states": [
        "COND_EVALUATED"
      ],
      "description": "根据权限策略评估访问条件"
    },
    "grant_access": {
      "namespace": "conditional",
      "pre_states": [
        "COND_EVALUATED"
      ],
      "post_states": [
        "COND_ACCEPTED"
      ],
      "invalidate": [
        "COND_EVALUATED"
      ],
      "description": "TRUE 分支：授予访问权限"
    },
    "deny_access": {
      "namespace": "conditional",
      "pre_states": [
        "COND_EVALUATED"
      ],
      "post_states": [
        "COND_REJECTED"
      ],
      "invalidate": [
        "COND_EVALUATED"
      ],
      "description": "FALSE 分支：拒绝访问"
    },
    "log_granted": {
      "namespace": "conditional",
      "pre_states": [
        "COND_ACCEPTED"
      ],
      "post_states": [
        "COND_RESOLVED"
      ],
      "invalidate": [
        "COND_ACCEPTED",
        "COND_RESOLVED"
      ],
      "description": "记录授权访问并结束条件判断"
    },
    "log_denied": {
      "namespace": "conditional",
      "pre_states": [
        "COND_REJECTED"
      ],
      "post_states": [
        "COND_RESOLVED"
      ],
      "invalidate": [
        "COND_REJECTED",
        "COND_RESOLVED"
      ],
      "description": "记录拒绝访问并结束条件判断"
    },
    "bypass_condition": {
      "namespace": "conditional",
      "pre_states": [
        "COND_EVALUATED"
      ],
      "post_states": [
        "COND_RESOLVED"
      ],
      "invalidate": [
        "COND_EVALUATED",
        "COND_RESOLVED"
      ],
      "description": "短路：直接绕过条件检查"
    },
    "retry_evaluation": {
      "namespace": "conditional",
      "pre_states": [
        "COND_EVALUATED"
      ],
      "post_states": [
        "COND_IDLE"
      ],
      "invalidate": [
        "COND_EVALUATED"
      ],
      "description": "重试：回到空闲状态重新评估"
    },
    "escalate_access": {
      "namespace": "conditional",
      "pre_states": [
        "COND_REJECTED"
      ],
      "post_states": [
        "COND_ACCEPTED"
      ],
      "invalidate": [
        "COND_REJECTED"
      ],
      "description": "升级：将被拒绝的访问升级为通过"
    },
    "audit_condition": {
      "namespace": "conditional",
      "pre_states": [
        "COND_ACCEPTED",
        "COND_REJECTED"
      ],
      "post_states": [
        "COND_RESOLVED"
      ],
      "invalidate": [
        "COND_ACCEPTED",
        "COND_REJECTED",
        "COND_RESOLVED"
      ],
      "description": "审计：无论分支结果如何，记录条件判断结果"
    },
    "init_fetch_loop": {
      "namespace": "loop",
      "pre_states": [
        "LOOP_IDLE"
      ],
      "post_states": [
        "FETCHING"
      ],
      "description": "初始化获取循环，开始获取数据"
    },
    "fetch_batch": {
      "namespace": "loop",
      "pre_states": [
        "FETCHING"
      ],
      "post_states": [
        "BATCH_READY"
      ],
      "invalidate": [
        "FETCHING"
      ],
      "description": "获取下一批数据"
    },
    "has_more_data": {
      "namespace": "loop",
      "pre_states": [
        "BATCH_READY"
      ],
      "post_states": [
        "ITERATING"
      ],
      "invalidate": [
        "BATCH_READY"
      ],
      "description": "检查还有更多数据 → 进入迭代体"
    },
    "process_item": {
      "namespace": "loop",
      "pre_states": [
        "ITERATING"
      ],
      "post_states": [
        "ITERATING"
      ],
      "description": "处理单个数据项（在迭代体内自循环）"
    },
    "next_iteration": {
      "namespace": "loop",
      "pre_states": [
        "ITERATING"
      ],
      "post_states": [
        "FETCHING"
      ],
      "invalidate": [
        "ITERATING"
      ],
      "description": "结束当前迭代 → 返回获取下一批"
    },
    "exit_loop": {
      "namespace": "loop",
      "pre_states": [
        "ITERATING"
      ],
      "post_states": [
        "LOOP_DONE"
      ],
      "invalidate": [
        "ITERATING",
        "LOOP_DONE"
      ],
      "description": "正常退出循环（所有数据已处理完毕）"
    },
    "retry_batch": {
      "namespace": "loop",
      "pre_states": [
        "BATCH_READY",
        "ITERATING"
      ],
      "post_states": [
        "FETCHING"
      ],
      "description": "获取失败 → 重试当前批次"
    },
    "timeout_exit": {
      "namespace": "loop",
      "pre_states": [
        "FETCHING",
        "ITERATING"
      ],
      "post_states": [
        "LOOP_DONE"
      ],
      "invalidate": [
        "FETCHING",
        "ITERATING",
        "LOOP_DONE"
      ],
      "description": "超时紧急退出循环"
    },
    "poll_status": {
      "namespace": "loop",
      "pre_states": [
        "ITERATING"
      ],
      "post_states": [
        "ITERATING"
      ],
      "description": "轮询状态更新（在迭代体内自循环）"
    },
    "auth_file_open": {
      "namespace": "cross",
      "pre_states": [
        "UNAUTHENTICATED"
      ],
      "post_states": [
        "AUTH_FILE_GATE"
      ],
      "description": "跨协议桥：认证 → 打开文件访问门"
    },
    "auth_file_read": {
      "namespace": "cross",
      "pre_states": [
        "AUTH_FILE_GATE"
      ],
      "post_states": [
        "AUTH_FILE_GATE"
      ],
      "description": "跨协议：通过认证门读取文件"
    },
    "auth_file_close": {
      "namespace": "cross",
      "pre_states": [
        "AUTH_FILE_GATE"
      ],
      "post_states": [
        "UNAUTHENTICATED"
      ],
      "invalidate": [
        "AUTH_FILE_GATE"
      ],
      "description": "跨协议：关闭经认证门的文件会话"
    },
    "auth_db_connect": {
      "namespace": "cross",
      "pre_states": [
        "UNAUTHENTICATED"
      ],
      "post_states": [
        "AUTH_DB_GATE"
      ],
      "description": "跨协议桥：认证 → 打开数据库连接"
    },
    "auth_db_query": {
      "namespace": "cross",
      "pre_states": [
        "AUTH_DB_GATE"
      ],
      "post_states": [
        "AUTH_DB_GATE"
      ],
      "description": "跨协议：通过认证门查询数据库"
    },
    "auth_db_disconnect": {
      "namespace": "cross",
      "pre_states": [
        "AUTH_DB_GATE"
      ],
      "post_states": [
        "UNAUTHENTICATED"
      ],
      "invalidate": [
        "AUTH_DB_GATE"
      ],
      "description": "跨协议：关闭经认证门的数据库连接"
    },
    "http_create_server": {
      "namespace": "tls",
